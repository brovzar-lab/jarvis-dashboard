# Paperclip (production fork — Billy Rovzar's instance)
VITE_PAPERCLIP_API_URL=https://paperclip.billyrovzar.com
PAPERCLIP_API_URL=https://paperclip.billyrovzar.com

# APPU is primary (the dashboard was built inside the APPU company)
VITE_PAPERCLIP_COMPANY_ID=da1766d2-228a-4b92-a4d3-b8cb6ec0b439

# Paperclip per-company API keys (slug = first 8 hex chars of company UUID, uppercased)
PAPERCLIP_API_KEY_DA1766D2=REPLACE_WITH_VALUE
PAPERCLIP_COMPANY_DA1766D2=da1766d2-228a-4b92-a4d3-b8cb6ec0b439

# Optional: LEMA — uncomment if dashboard should also surface LEMA data
# VITE_PAPERCLIP_COMPANY_ID=da1766d2-228a-4b92-a4d3-b8cb6ec0b439,ff52ad91-250b-4d9d-a2ee-1d24b65ec3e8
# PAPERCLIP_API_KEY_FF52AD91=REPLACE_WITH_VALUE
# PAPERCLIP_COMPANY_FF52AD91=ff52ad91-250b-4d9d-a2ee-1d24b65ec3e8

# Google OAuth (Gmail + Calendar) — refresh token flow
GOOGLE_CLIENT_ID=REPLACE_WITH_VALUE
GOOGLE_CLIENT_SECRET=REPLACE_WITH_VALUE
GOOGLE_REFRESH_TOKEN=REPLACE_WITH_VALUE

# Obsidian Local REST API (via Cloudflare Tunnel)
OBSIDIAN_API_URL=https://obsidian.billyrovzar.com
OBSIDIAN_API_KEY=REPLACE_WITH_VALUE

# ElevenLabs TTS (optional — falls back to browser TTS)
VITE_ELEVENLABS_API_KEY=REPLACE_WITH_VALUE
VITE_ELEVENLABS_VOICE_ID=ErXwobaYiN019PkySvjV

# Claude API (optional — natural language understanding)
VITE_CLAUDE_API_KEY=REPLACE_WITH_VALUE
